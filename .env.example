# Kopier til .env og fyll ut.

# Adressa appen blir nådd på.
JUL_PUBLIC_URL=https://jul.example.com

# Nøkkel til Nissen og prissjekken frå https://platform.openai.com. Utan denne fungerer alt anna som normalt.
OPENAI_API_KEY=

# Startmodell. Kan endrast seinare under Administrasjon i appen.
OPENAI_MODEL=gpt-6.1-sol

# Valfritt: eigen invitasjonskode. Tom gir ein tilfeldig kode som blir lagra i datavolumet.
JUL_INVITE_CODE=

# Set til true berre mellombels om du treng PocketBase-administrasjonen på /_/.
JUL_ENABLE_ADMIN=false

# Valfritt: namnet på Docker-volumet med data. Standard er pakkelapp-data.
JUL_DATA_VOLUME=

